<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 en adelante arma su propia pantalla de arranque: el icono
         de la app sobre un color. Sin decirle cual, usaba negro con el
         telefono en modo oscuro. La app es siempre clara, asi que va crema. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/fondo_arranque</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
