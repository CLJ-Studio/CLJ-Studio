# Copia este archivo como .env y rellena los valores.
# .env esta en .gitignore: NUNCA subas secretos al repositorio.

# --- Google OAuth (Google Cloud Console > Credenciales > ID de cliente OAuth) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# --- Proyecto en la nube (Supabase > Project Settings > General / API) ---
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=la-contrasena-de-la-base

# --- Claves que consume el Frontend Flutter (Project Settings > API) ---
# La anon key es PUBLICA por diseno: puede ir en el cliente.
# La proteccion real son las politicas RLS, no ocultar esta clave.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# La service_role key IGNORA todas las RLS.
# Solo para scripts de administracion. JAMAS en el Frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Claves VAPID de Web Push (Backend/supabase/functions/enviar-push)
# La publica tambien vive en el codigo Flutter: identifica al servidor
# ante el navegador y no es secreta. La privada SI lo es.
VAPID_PUBLIC_KEY=BBZ6ZrJPvdu1JDPkk9LSHQZvuYwJDpwdOfkKDNK78Z5trgP1QfqlkO5X03durNEaGxOKuqIM3AvyhVNsPnpgv54
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# --- APNs, las notificaciones del iPhone (Apple Developer > Keys) ---
# El iPhone instalado no usa Web Push ni Firebase: habla directo con Apple.
# Los tres primeros identifican la clave y la app, y no son secretos.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.cljstudio.umarket

# El contenido del archivo .p8 que descarga Apple, ENTERO, con sus lineas
# -----BEGIN/END PRIVATE KEY-----. Apple lo deja descargar UNA sola vez.
# Es tan secreto como una contrasena: quien lo tenga puede mandar avisos en
# nombre de la app. Va como secreto de la Edge Function, nunca aqui ni en
# un mensaje. Si se filtro, se revoca en Apple y se genera otra.
#   supabase secrets set APNS_PRIVATE_KEY="$(cat AuthKey_XXXXXXXXXX.p8)"
APNS_PRIVATE_KEY=
