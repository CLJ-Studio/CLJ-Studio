# Copia este archivo como .env y rellena los valores.
# .env esta en .gitignore: NUNCA subas secretos al repositorio.

# --- Google OAuth (Google Cloud Console > Credenciales > ID de cliente OAuth) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# --- Proyecto en la nube (Supabase > Project Settings > General / API) ---
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=la-contrasena-de-la-base

# --- Claves que consume el Frontend Flutter (Project Settings > API) ---
# La anon key es PUBLICA por diseno: puede ir en el cliente.
# La proteccion real son las politicas RLS, no ocultar esta clave.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# La service_role key IGNORA todas las RLS.
# Solo para scripts de administracion. JAMAS en el Frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
